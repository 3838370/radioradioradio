// role: keys
// genres: saw 1
// energy: 0.1-0.9
params({ keys: 'grand' })
fx({ rev: 0.4, delay: 0.15, lpf: 4200 })
loop('left', (i) => {
  const shape = vary('shape', ['block', 'broken', 'alberti'], 16)
  const c = harm(0, vary('ext', ['', '7', '9'], 8))
  if (shape === 'block') { synth(P.keys, c, { vel: rrand(0.5, 0.75), strum: 0.04 }); sleep(4) }
  else if (shape === 'broken') { for (const n of c) { synth(P.keys, n, { vel: rrand(0.45, 0.65) }); sleep(4 / c.length) } }
  else { for (const k of [0, 2, 1, 2, 0, 2, 1, 2]) { synth(P.keys, c[k % c.length], { vel: k === 0 ? 0.65 : 0.4 }); sleep(0.5) } }
})
loop('right', (i) => {
  for (const n of phrase('r', { beats: 4, density: vary('d', [0.3, 0.5, 0.7], 8), octave: 2 })) {
    if (n.note) synth(P.keys, n.note, { vel: n.vel * 0.85, nudge: n.nudge })
    sleep(n.dur)
  }
})
