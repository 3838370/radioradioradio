// role: keys
// genres: saw 1, drill 0.7
// energy: 0-1
params({ prepared: 'prepared_piano' })
fx({ rev: 0.4 })
loop('chords', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['triad', 'add9'], 16), rhythm: 'push', octave: 1, density: 0.4 })) {
    if (c.notes) synth(P.prepared, c.notes, { vel: 0.6 * c.vel + 0.3, strum: 0.04 })
    sleep(c.dur)
  }
})
