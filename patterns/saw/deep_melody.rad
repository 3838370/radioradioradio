// role: lead
// genres: saw 1
// energy: 0.2-1
params({ keys: 'epiano' })
fx({ delay: 0.4, rev: 0.5 })
loop('melody', (i) => {
  for (const n of phrase('m', { beats: 4, density: vary('dens', [0.35, 0.5, 0.65], 16), octave: 2 })) {
    if (n.note) synth(P.keys, n.note, { amp: 0.26 * n.vel, release: 1.5 })
    sleep(n.dur)
  }
})
