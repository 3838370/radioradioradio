// role: lead
// genres: saw 1, drill 0.6
// energy: 0.15-1
params({ lead: 'aphex_lead', odds: 4 })
fx({ rev: 0.4, delay: 0.25, lpf: 3000 })
loop('lead', (i) => {
  for (const n of melody('l', { style: 'ostinato', octave: 2 })) {
    if (n.note && !one_in(P.odds)) synth(P.lead, n.note, { dur: n.len * 1.2, amp: 0.2 * n.vel })
    sleep(n.dur)
  }
})
