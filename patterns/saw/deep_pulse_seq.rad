// role: lead
// genres: saw 1
// energy: 0.3-1
params({ lead: 'pulse' })
fx({ delay: 0.35, rev: 0.4, lpf: 2400 })
loop('seq', (i) => {
  const notes = modal(1, 1)
  const order = ring(0, 4, 2, 4, 7, 4, 2, 4)
  for (let k = 0; k < 8; k++) {
    synth(P.lead, notes[order.tick() % notes.length], { amp: 0.25, cutoff: 600 + 900 * ENERGY })
    sleep(0.5)
  }
})
