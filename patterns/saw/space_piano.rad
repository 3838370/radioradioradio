// role: lead
// genres: saw 1
// energy: 0-1
params({ keys: 'piano' })
fx({ rev: 0.55, delay: 0.25, lpf: 5000, wobble: 0.15 })
loop('right', (i) => {
  for (const n of phrase('right', { beats: 8, density: vary('dens', [0.3, 0.5, 0.7], 16), octave: 2 })) {
    if (n.note) synth(P.keys, n.note, { amp: 0.34 * n.vel })
    sleep(n.dur)
  }
})
loop('left', (i) => {
  synth(P.keys, harm(1, vary('ext', ['', '7', '9'], 8)), { amp: 0.14 })
  sleep(vary('lh', [4, 8], 8))
})
