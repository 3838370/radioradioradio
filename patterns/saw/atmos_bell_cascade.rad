// role: lead
// genres: saw 1
// energy: 0.3-1
fx({ delay: 0.35, rev: 0.35 })
loop('bells', (i) => {
  for (const n of motif('m', { beats: 4, density: 0.8, octave: 3 })) {
    if (n.note) synth(vary('inst', ['dx_bell', 'fm_glass'], 16), n.note, { dur: n.dur, amp: 0.16 * n.vel, pan: rrand(-0.5, 0.5) })
    sleep(n.dur)
  }
})
