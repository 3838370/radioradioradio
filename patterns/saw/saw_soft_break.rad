// role: drums
// genres: saw 1, boc 0.7
// energy: 0.3-1
params({ kit: 'dr' })
fx({ lpf: walk('lpf', 1800, 4000, 0.1), rev: 0.25, crush: 0.06 })
loop('break', (i) => {
  const b = beat('b', { style: 'fsol_break', density: 0.45 })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kit, { n: 2, amp: 0.7 * st.v })
    if (st.s) s(P.kit, { n: 18, amp: 0.35 * st.v })
    if (st.h) s(P.kit, { n: 26, amp: 0.1 * st.v, pan: 0.3 })
    sleep(0.25)
  }
})
