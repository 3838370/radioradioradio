// role: texture
// genres: saw 1, space 0.6
// energy: 0-0.9
fx({ rev: 0.4, lpf: 5000 })
loop('field', (i) => {
  for (const e of collage('c', { pool: ['outdoor', 'wind', 'birds3'], rate: walk('r', 0.15, 0.4, 0.1) })) {
    if (e.s) s(e.s, { n: e.n, rate: e.rate, begin: e.begin, pan: e.pan, amp: e.amp * 0.7, cut: 4 })
    sleep(e.dur)
  }
})
