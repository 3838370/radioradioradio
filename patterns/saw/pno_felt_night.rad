// role: lead
// genres: saw 1
// energy: 0-0.6
params({ keys: 'felt' })
fx({ rev: 0.6, delay: 0.3, lpf: 2600, wobble: 0.3 })
loop('felt', (i) => {
  for (const n of phrase('f', { beats: 8, density: 0.15, octave: 1, rest: 0.4, evolve: 3 })) {
    if (n.note) synth(P.keys, [n.note, n.note + 12], { vel: n.vel * 0.8, nudge: n.nudge * 2, strum: 0.03 })
    sleep(n.dur)
  }
})
