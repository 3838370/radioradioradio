// role: keys
// genres: saw 1
// energy: 0-1
params({ keys: 'felt' })
fx({ rev: 0.5, delay: 0.3, lpf: 3500 })
loop('arp', (i) => {
  const ch = harm(vary('oct', [1, 2], 8), vary('ext', ['7', '9'], 8))
  const order = vary('order', [[0, 1, 2, 3], [0, 2, 1, 3], [3, 2, 1, 0], [0, 2, 3, 1]], 8)
  for (const k of order) {
    if (ch[k] != null) synth(P.keys, ch[k], { amp: 0.25 })
    sleep(1)
  }
})
