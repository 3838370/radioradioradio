// role: lead
// genres: saw 1, dark 0.7
// energy: 0-0.9
params({ lead: 'saw2_square' })
fx({ rev: 0.5, lpf: 2000, wobble: 0.2 })
loop('square', (i) => {
  for (const n of melody('d', { style: 'drift', octave: 2 })) {
    if (n.note) synth(P.lead, n.note, { dur: n.len, amp: 0.24 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
