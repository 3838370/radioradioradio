// role: drums
// genres: saw 1, boc 0.7
// energy: 0.25-1
params({ kick: '808bd', snare: '808sd', hat: 'hh27' })
fx({ lpf: 4500, rev: 0.3, wobble: 0.1 })
loop('kit', (i) => {
  const b = beat('b', { style: 'saw808', density: walk('d', 0.3, 0.6, 0.1) })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 8, amp: 0.75 * st.v })
    if (st.s) s(P.snare, { n: 3, amp: 0.3 * st.v })
    if (st.h) s(P.hat, { n: 1, amp: 0.1 * st.v, pan: 0.25 })
    sleep(0.25)
  }
})
