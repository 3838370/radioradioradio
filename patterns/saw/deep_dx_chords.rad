// role: keys
// genres: saw 1
// energy: 0.15-1
params({ pad: 'dx_pad' })
fx({ rev: 0.35, delay: 0.2, lpf: 3500 })
loop('chords', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['m7', 'add9'], 16), rhythm: 'push', octave: 1, density: 0.6 })) {
    if (c.notes) synth(P.pad, c.notes, { dur: Math.max(0.5, c.len), amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
