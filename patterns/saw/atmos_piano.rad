// role: keys
// genres: saw 1
// energy: 0.2-1
params({ keys: 'piano' })
fx({ rev: 0.45, delay: 0.25, lpf: 5000 })
loop('piano', (i) => {
  const voicing = harm(1, vary('ext', ['7', '9'], 8))
  const rhythm = vary('rh', [[0, 1.5, 3], [0, 2.75], [0.5, 2, 3.5], [0, 2.5]], 8)
  let t = 0
  for (const r of rhythm) {
    sleep(r - t)
    synth(P.keys, r == 0 ? voicing : voicing.slice(1), { amp: r == 0 ? 0.2 : 0.13 })
    t = r
  }
  sleep(4 - t)
})
