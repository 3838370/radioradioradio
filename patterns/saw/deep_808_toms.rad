// role: perc
// genres: saw 1, acid 0.7
// energy: 0.2-1
fx({ rev: 0.3, delay: 0.25, lpf: 4000 })
loop('toms', (i) => {
  const hits = spread(vary('h', [3, 4, 5], 8), 16, 2)
  const toms = ['808lt', '808mt', '808ht']
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(toms[(k + i) % 3], { n: 0, amp: 0.2, pan: (k % 3 - 1) * 0.4 })
    sleep(0.25)
  }
})
