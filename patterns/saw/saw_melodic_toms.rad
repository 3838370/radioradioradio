// role: perc
// genres: saw 1, acid 0.7
// energy: 0.2-1
fx({ rev: 0.3, delay: 0.2 })
loop('toms', (i) => {
  for (const n of melody('t', { style: 'ostinato', octave: 1 })) {
    if (n.note) s(n.note % 3 == 0 ? '808lt' : n.note % 3 == 1 ? '808mt' : '808ht', { n: 0, amp: 0.16 * n.vel, rate: 1 + (n.note % 5) * 0.03 })
    sleep(n.dur)
  }
})
