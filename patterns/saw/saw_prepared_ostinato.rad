// role: lead
// genres: saw 1, drill 0.7
// energy: 0-1
params({ prepared: 'prepared_piano' })
fx({ rev: 0.35, lpf: 4000 })
loop('piano', (i) => {
  for (const n of melody('p', { style: 'ostinato', octave: 2 })) {
    if (n.note) synth(P.prepared, n.note, { vel: 0.5 + 0.5 * n.vel })
    sleep(n.dur)
  }
})
