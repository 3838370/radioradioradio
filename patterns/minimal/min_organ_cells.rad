// role: lead
// genres: minimal 1
// energy: 0.2-1
params({ organ: 'efd_organ' })
fx({ delay: 0.25, rev: 0.2 })
loop('organ', (i) => {
  for (const n of melody('c', { style: 'cells', octave: 2 })) {
    if (n.notes.length) synth(P.organ, n.notes, { dur: 0.2, amp: 0.18 * n.vel })
    sleep(n.dur)
  }
})
