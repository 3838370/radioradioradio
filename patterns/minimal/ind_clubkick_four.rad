// role: drums
// genres: minimal 1
// energy: 0.4-1
params({ kick: 'clubkick', metal: 'industrial', metal2: 'metal' })
fx({ lpf: 7000, crush: 0.12, rev: 0.1 })
loop('kit', (i) => {
  const b = beat('b', { style: 'four', density: walk('d', 0.4, 0.8, 0.1) })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 3, amp: 0.9 * st.v })
    if (st.s) s(P.metal, { n: 4, amp: 0.3 * st.v })
    if (st.h) s(P.metal2, { n: 1, amp: 0.08 * st.v, pan: 0.3 })
    if (st.p) s(P.metal, { n: 12, amp: 0.1 * st.v, pan: -0.3 })
    sleep(0.25)
  }
})
