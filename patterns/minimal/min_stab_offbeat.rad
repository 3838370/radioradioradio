// role: keys
// genres: minimal 1
// energy: 0.35-1
params({ organ: 'efd_stab' })
fx({ delay: 0.3, lpf: 4000 })
loop('stabs', (i) => {
  for (const c of chords('c', { voicing: 'm7', rhythm: 'offbeat', octave: 1, density: walk('d', 0.3, 0.7, 0.1) })) {
    if (c.notes) synth(P.organ, c.notes, { amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
