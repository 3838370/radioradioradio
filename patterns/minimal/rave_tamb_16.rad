// role: perc
// genres: minimal 1
// energy: 0.45-1
params({ kit: 'drumtraks', odds: 4 })
fx({ lpf: 8000, rev: 0.1 })
loop('tamb', (i) => {
  for (let k = 0; k < 16; k++) {
    const accent = k % 4 == 2
    if (accent || !one_in(P.odds)) s(P.kit, { n: 10, amp: accent ? 0.16 : 0.07, pan: -0.25 })
    sleep(0.25)
  }
})
