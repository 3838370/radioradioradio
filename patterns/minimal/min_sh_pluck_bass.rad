// role: bass
// genres: minimal 1, acid 0.5
// energy: 0.35-1
params({ acid_bass: 'sh_bass' })
fx({ lpf: walk('lpf', 400, 1100, 0.1) })
loop('bass', (i) => {
  for (const b of bassline('b', { style: 'dub' })) {
    if (b.note) synth(P.acid_bass, b.note, { dur: 0.25, amp: 0.34 * b.vel, cutoff: 500 })
    sleep(b.dur)
  }
})
