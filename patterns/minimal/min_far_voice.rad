// role: texture
// genres: minimal 1, boc 0.4
// energy: 0-1
fx({ rev: 0.5, delay: 0.4, lpf: 2500 })
loop('voice', (i) => {
  for (const e of collage('c', { pool: ['speechless', 'speech'], rate: 0.12 })) {
    if (e.s) s(e.s, { n: e.n, rate: e.rate, pan: e.pan, amp: e.amp * 0.35, cut: 1 })
    sleep(e.dur)
  }
})
