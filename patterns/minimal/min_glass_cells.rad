// role: lead
// genres: minimal 1, space 0.5
// energy: 0-1
params({ bell: 'fm_glass' })
fx({ delay: 0.4, rev: 0.4 })
loop('glass', (i) => {
  for (const n of melody('c', { style: 'cells', octave: 3 })) {
    if (n.notes.length) synth(P.bell, n.notes, { amp: 0.14 * n.vel })
    sleep(n.dur)
  }
})
