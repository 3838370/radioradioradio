// role: lead
// genres: drill 1, acid 0.5
// energy: 0.35-1
params({ lead: 'aphex_lead', odds: 5 })
fx({ rev: 0.3, delay: 0.2, lpf: 3500 })
loop('lead', (i) => {
  for (const n of melody('m', { style: 'ostinato', octave: 2 })) {
    if (n.note && !one_in(P.odds)) synth(P.lead, n.note, { dur: n.len, amp: 0.18 * n.vel })
    sleep(n.dur)
  }
})
