// role: perc
// genres: drill 1, space 0.5
// energy: 0.4-1
fx({ rev: 0.2, delay: 0.1 })
loop('tabla', (i) => {
  const hits = spread(vary('h', [9, 11, 13], 4), 16, vary('r', [0, 3], 8))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s('tabla2', { n: rrand_i(0, 45), amp: 0.11, rate: 1.1, pan: rrand(-0.5, 0.5) })
    sleep(0.25)
  }
})
