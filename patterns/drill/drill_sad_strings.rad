// role: keys
// genres: drill 1, saw 0.6
// energy: 0.2-1
params({ pad: 'string_machine' })
fx({ rev: 0.5, lpf: 2600 })
loop('strings', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['m7', 'add9'], 16), rhythm: 'long', octave: 1 })) {
    if (c.notes) synth(P.pad, c.notes, { dur: c.len, attack: 1, amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
