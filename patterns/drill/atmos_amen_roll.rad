// role: drums
// genres: drill 1
// energy: 0.4-1
fx({ lpf: 9000, rev: 0.12, crush: 0.1 })
loop('amen', (i) => {
  const fill = ring(8, 9, 10, 11)
  for (let k = 0; k < 16; k++) {
    let slice = k + 16 * (i % 2)
    if (k >= 12 && i % 4 == 3) slice = fill.tick()
    s('amencutup', { n: slice, amp: 0.55, rate: 1.25, cut: 0.25 })
    sleep(0.25)
  }
})
