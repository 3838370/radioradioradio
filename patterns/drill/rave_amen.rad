// role: drums
// genres: drill 1
// energy: 0.5-1
params({ odds: 3 })
fx({ lpf: 10000, crush: 0.15 })
loop('amen', (i) => {
  const map = vary('map', [[0, 1, 2, 3], [0, 1, 0, 3], [2, 1, 2, 3], [0, 3, 2, 1]], 4)
  for (let k = 0; k < 16; k++) {
    const slice = map[Math.floor(k / 4)] * 4 + (k % 4) + 16 * (i % 2)
    if (!(k == 15 && one_in(P.odds))) s('amencutup', { n: slice, amp: 0.6, rate: 1.09, cut: 0.25 })
    sleep(0.25)
  }
})
