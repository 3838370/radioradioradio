// role: perc
// genres: drill 1, ae 0.6
// energy: 0.4-1
fx({ crush: 0.15, delay: 0.1 })
loop('clicks', (i) => {
  const odds = vary('odds', [2, 3, 5], 4)
  for (let k = 0; k < 32; k++) {
    if (one_in(odds)) s(choose(['click', 'glitch2']), { n: rrand_i(0, 4), amp: 0.07, rate: choose([1, 1.5, 2]), pan: rrand(-0.8, 0.8), cut: 0.05 })
    sleep(0.125)
  }
})
