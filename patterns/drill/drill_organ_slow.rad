// role: keys
// genres: drill 1, minimal 0.5
// energy: 0.25-1
params({ organ: 'efd_organ' })
fx({ rev: 0.35, lpf: 3000 })
loop('organ', (i) => {
  for (const c of chords('c', { voicing: 'm7', rhythm: 'long', octave: 1 })) {
    if (c.notes) synth(P.organ, c.notes, { dur: c.len * 0.9, amp: 0.16 * c.vel })
    sleep(c.dur)
  }
})
