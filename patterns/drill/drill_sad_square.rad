// role: lead
// genres: drill 1, dark 0.5
// energy: 0.25-1
params({ lead: 'saw2_square' })
fx({ rev: 0.45, delay: 0.3, lpf: 2400 })
loop('lead', (i) => {
  for (const n of melody('d', { style: 'drift', octave: 2 })) {
    if (n.note) synth(P.lead, n.note, { dur: n.len, amp: 0.22 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
