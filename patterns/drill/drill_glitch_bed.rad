// role: texture
// genres: drill 1, ae 0.5
// energy: 0.3-1
fx({ crush: 0.2, delay: 0.25 })
loop('glitch', (i) => {
  for (const e of collage('c', { pool: ['glitch2', 'glitch', 'sid'], rate: walk('r', 0.4, 0.9, 0.1) })) {
    if (e.s) s(e.s, { n: e.n, rate: e.rate * 2, pan: e.pan, amp: e.amp * 0.45, cut: 0.08 })
    sleep(e.dur)
  }
})
