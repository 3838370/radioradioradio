// role: lead
// genres: ae 1
// energy: 0.3-1
params({ lead: 'sh_lead', odds: 4 })
fx({ crush: 0.12, delay: 0.2, lpf: 6000 })
loop('lead', (i) => {
  for (const n of motif('m', { beats: 4, density: 0.8, octave: 2 })) {
    if (n.note && !one_in(P.odds)) synth(P.lead, n.note, { dur: n.dur * 0.5, amp: 0.2 * n.vel, nudge: rrand(0, 0.08) })
    sleep(n.dur)
  }
})
