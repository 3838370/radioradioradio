// role: perc
// genres: ae 1
// energy: 0.3-1
fx({ rev: 0.25, delay: 0.15, lpf: 7000 })
loop('metal', (i) => {
  const hits = spread(vary('h', [5, 7, 9], 8), 16, vary('r', [0, 3, 5], 4))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(vary('src', ['metal', 'can', 'industrial'], 8), { n: rrand_i(0, 9), amp: 0.14, rate: walk('rate', 0.6, 1.6, 0.15), pan: rrand(-0.7, 0.7) })
    sleep(0.25)
  }
})
