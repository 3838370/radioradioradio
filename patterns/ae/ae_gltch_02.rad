// role: perc
// genres: ae 0.95
// energy: 0.4-1
params({ gl_crunch: 'gl_crunch', gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss', gl_ping: 'gl_ping' })
fx({ crush: 0.31, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 02 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_crunch', 2, 60, 0.37, 2848, 1], [2, 'gl_buzz', 4, 40, 0.52, 200, 1], [9, 'gl_buzz', 1, 31, 0.46, 200, 1],
    [11, 'gl_crunch', 2, 60, 0.39, 2658, 2], [14, 'gl_hiss', 1, 60, 0.32, 8064, 2], [16, 'gl_crunch', 1, 60, 0.42, 2090, 2],
    [18, 'gl_buzz', 4, 31, 0.54, 200, 2], [22, 'gl_buzz', 2, 40, 0.46, 200, 2], [24, 'gl_ping', 4, 99, 0.44, 0, 2],
    [28, 'gl_crunch', 7, 60, 0.58, 2229, 2], [36, 'gl_crunch', 1, 60, 0.42, 2325, 2], [38, 'gl_crunch', 3, 60, 0.51, 2859, 2],
    [42, 'gl_hiss', 8, 60, 0.43, 9449, 2], [50, 'gl_buzz', 3, 38, 0.44, 200, 2], [53, 'gl_buzz', 4, 39, 0.57, 200, 2],
    [58, 'gl_buzz', 4, 39, 0.47, 1688, 1], [62, 'gl_buzz', 2, 39, 0.49, 1383, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
