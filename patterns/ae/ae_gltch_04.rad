// role: perc
// genres: ae 0.95, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss', gl_crunch: 'gl_crunch_fast', gl_crunch2: 'gl_crunch', gl_ping: 'gl_ping' })
fx({ crush: 0.34, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 04 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 1, 26, 0.48, 200, 1], [3, 'gl_hiss', 1, 60, 0.51, 5318, 2], [7, 'gl_buzz', 1, 40, 0.58, 200, 1],
    [9, 'gl_crunch', 5, 60, 0.54, 2960, 1], [14, 'gl_crunch', 1, 60, 0.53, 3067, 2], [16, 'gl_buzz', 1, 36, 0.48, 4000, 2],
    [18, 'gl_crunch2', 1, 60, 0.55, 2907, 2], [20, 'gl_buzz', 1, 45, 0.41, 4000, 2], [22, 'gl_crunch2', 4, 60, 0.56, 2707, 2],
    [29, 'gl_buzz', 1, 38, 0.61, 200, 2], [31, 'gl_buzz', 1, 45, 0.42, 4000, 2], [32, 'gl_buzz', 4, 35, 0.63, 200, 2],
    [37, 'gl_crunch', 2, 60, 0.49, 3183, 2], [39, 'gl_crunch2', 8, 60, 0.56, 2845, 1], [47, 'gl_hiss', 8, 60, 0.56, 7445, 1],
    [55, 'gl_ping', 3, 112, 0.43, 0, 2], [58, 'gl_buzz', 6, 39, 0.61, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
