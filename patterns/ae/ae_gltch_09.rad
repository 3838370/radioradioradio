// role: perc
// genres: ae 0.95, drill 0.5, acid 0.4
// energy: 0.4-1
params({ gl_ping: 'gl_ping', gl_crunch: 'gl_crunch', gl_hiss: 'gl_hiss', gl_buzz: 'gl_buzz', gl_crunch2: 'gl_crunch_fast' })
fx({ crush: 0.34, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 09 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_ping', 1, 112, 0.35, 0, 2], [1, 'gl_ping', 1, 112, 0.48, 0, 1], [2, 'gl_crunch', 4, 60, 0.59, 2665, 1],
    [6, 'gl_hiss', 2, 60, 0.51, 4000, 1], [8, 'gl_buzz', 8, 40, 0.63, 200, 1], [16, 'gl_buzz', 8, 40, 0.52, 200, 2],
    [24, 'gl_buzz', 8, 37, 0.47, 200, 1], [32, 'gl_hiss', 8, 60, 0.49, 12000, 2], [40, 'gl_ping', 2, 112, 0.47, 0, 2],
    [42, 'gl_hiss', 3, 60, 0.65, 4000, 1], [48, 'gl_crunch2', 8, 60, 0.57, 3021, 1], [56, 'gl_buzz', 1, 45, 0.43, 4000, 2],
    [58, 'gl_hiss', 1, 60, 0.48, 4000, 1], [60, 'gl_hiss', 1, 60, 0.47, 5011, 1], [62, 'gl_buzz', 2, 40, 0.53, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
