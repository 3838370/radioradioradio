// role: perc
// genres: ae 0.95, drill 0.5, acid 0.4
// energy: 0.4-1
params({ gl_crunch: 'gl_crunch_fast', gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss', gl_crunch2: 'gl_crunch', gl_ping: 'gl_ping' })
fx({ crush: 0.34, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 15 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_crunch', 4, 60, 0.6, 3125, 1], [4, 'gl_buzz', 8, 28, 0.55, 200, 2], [12, 'gl_hiss', 3, 60, 0.52, 4000, 2],
    [15, 'gl_buzz', 2, 35, 0.55, 200, 2], [18, 'gl_buzz', 4, 25, 0.52, 200, 2], [22, 'gl_buzz', 4, 23, 0.63, 200, 2],
    [29, 'gl_buzz', 1, 45, 0.49, 1534, 2], [32, 'gl_hiss', 1, 60, 0.48, 7364, 2], [33, 'gl_crunch2', 1, 60, 0.58, 2857, 1],
    [35, 'gl_hiss', 1, 60, 0.49, 7423, 1], [37, 'gl_crunch2', 2, 60, 0.64, 2055, 2], [39, 'gl_ping', 1, 107, 0.54, 0, 2],
    [41, 'gl_crunch2', 7, 60, 0.65, 2678, 2], [48, 'gl_hiss', 4, 60, 0.48, 4000, 2], [52, 'gl_crunch2', 4, 60, 0.64, 2307, 1],
    [58, 'gl_crunch2', 1, 60, 0.44, 2283, 2], [61, 'gl_ping', 2, 103, 0.55, 0, 1], [63, 'gl_crunch2', 1, 60, 0.54, 2706, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
