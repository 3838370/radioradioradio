// role: bass
// genres: ae 1
// energy: 0.3-1
params({ sub: 'fm_sub' })
fx({ rev: 0.1, delay: 0.15 })
loop('fm', (i) => {
  const hits = spread(vary('h', [5, 7, 9], 8), 16, vary('rot', [0, 3, 7], 4))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) synth(P.sub, ROOT - 12 + choose([0, 0, 12, 7]), { amp: 0.5, pan: rrand(-0.2, 0.2) })
    sleep(0.25)
  }
})
