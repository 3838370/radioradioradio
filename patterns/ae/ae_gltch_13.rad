// role: perc
// genres: ae 0.95, drill 0.5
// energy: 0.4-1
params({ gl_crunch: 'gl_crunch_fast', gl_buzz: 'gl_buzz', gl_ping: 'gl_ping', gl_crunch2: 'gl_crunch' })
fx({ crush: 0.29, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 13 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_crunch', 8, 60, 0.55, 3099, 1], [8, 'gl_buzz', 6, 31, 0.64, 200, 1], [14, 'gl_buzz', 7, 25, 0.57, 200, 1],
    [21, 'gl_ping', 2, 104, 0.61, 0, 1], [23, 'gl_crunch', 1, 60, 0.49, 3432, 2], [26, 'gl_buzz', 4, 40, 0.46, 200, 2],
    [31, 'gl_buzz', 1, 45, 0.47, 1736, 2], [32, 'gl_buzz', 8, 40, 0.62, 200, 1], [40, 'gl_buzz', 4, 45, 0.52, 3615, 2],
    [44, 'gl_buzz', 6, 40, 0.64, 200, 1], [50, 'gl_buzz', 8, 45, 0.59, 1473, 1], [58, 'gl_crunch2', 6, 60, 0.6, 2175, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
