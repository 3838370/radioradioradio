// role: perc
// genres: ae 0.95, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss', gl_crunch: 'gl_crunch_fast', gl_crunch2: 'gl_crunch' })
fx({ crush: 0.32, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 12 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 2, 45, 0.57, 1832, 2], [2, 'gl_buzz', 4, 35, 0.63, 200, 1], [7, 'gl_hiss', 1, 60, 0.38, 12000, 2],
    [10, 'gl_buzz', 2, 39, 0.63, 200, 1], [13, 'gl_buzz', 8, 40, 0.58, 200, 1], [22, 'gl_crunch', 4, 60, 0.65, 2946, 1],
    [27, 'gl_hiss', 1, 60, 0.45, 11073, 2], [28, 'gl_buzz', 1, 45, 0.62, 2848, 1], [30, 'gl_crunch', 1, 60, 0.49, 3033, 2],
    [31, 'gl_buzz', 3, 32, 0.59, 200, 1], [34, 'gl_hiss', 8, 60, 0.58, 8719, 1], [42, 'gl_buzz', 1, 24, 0.36, 200, 1],
    [43, 'gl_buzz', 3, 40, 0.61, 200, 1], [46, 'gl_crunch2', 3, 60, 0.53, 2573, 1], [50, 'gl_crunch', 8, 60, 0.5, 3095, 2],
    [58, 'gl_crunch2', 6, 60, 0.54, 2912, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
