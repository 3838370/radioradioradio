// role: perc
// genres: ae 0.95, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss' })
fx({ crush: 0.37, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 08 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 3, 36, 0.62, 200, 1], [3, 'gl_buzz', 8, 38, 0.61, 200, 1], [11, 'gl_buzz', 8, 23, 0.45, 200, 1],
    [19, 'gl_buzz', 8, 28, 0.53, 200, 1], [27, 'gl_buzz', 5, 35, 0.56, 200, 1], [32, 'gl_buzz', 1, 40, 0.52, 200, 1],
    [36, 'gl_buzz', 5, 40, 0.6, 200, 2], [42, 'gl_buzz', 2, 28, 0.49, 200, 2], [45, 'gl_hiss', 4, 60, 0.57, 4000, 2],
    [51, 'gl_buzz', 2, 40, 0.51, 200, 2], [54, 'gl_buzz', 8, 24, 0.5, 200, 1], [62, 'gl_buzz', 2, 38, 0.59, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
