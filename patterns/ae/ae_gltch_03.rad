// role: perc
// genres: ae 0.95, drill 0.5, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch', gl_hiss: 'gl_hiss', gl_crunch2: 'gl_crunch_fast', gl_ping: 'gl_ping' })
fx({ crush: 0.33, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 03 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 1, 26, 0.39, 200, 1], [1, 'gl_crunch', 1, 60, 0.49, 2785, 2], [3, 'gl_hiss', 1, 60, 0.46, 4000, 2],
    [5, 'gl_hiss', 1, 60, 0.5, 5835, 2], [6, 'gl_buzz', 5, 40, 0.65, 200, 1], [15, 'gl_buzz', 1, 45, 0.38, 4000, 2],
    [16, 'gl_buzz', 6, 40, 0.54, 200, 2], [22, 'gl_buzz', 3, 37, 0.56, 200, 2], [26, 'gl_crunch', 3, 60, 0.59, 2274, 1],
    [30, 'gl_crunch', 1, 60, 0.53, 2781, 2], [32, 'gl_crunch2', 5, 60, 0.57, 2989, 1], [37, 'gl_ping', 1, 112, 0.36, 0, 1],
    [38, 'gl_buzz', 3, 45, 0.58, 1928, 1], [43, 'gl_hiss', 2, 60, 0.51, 4000, 2], [47, 'gl_crunch2', 1, 60, 0.4, 3012, 2],
    [48, 'gl_buzz', 8, 41, 0.49, 1728, 1], [56, 'gl_crunch', 3, 60, 0.41, 2318, 1], [60, 'gl_buzz', 2, 38, 0.41, 200, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
