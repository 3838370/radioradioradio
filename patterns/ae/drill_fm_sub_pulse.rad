// role: bass
// genres: ae 0.5
// energy: 0.45-1
params({ sub: 'fm_sub', odds: 4 })
fx({ lpf: 800, crush: 0.05 })
loop('bass', (i) => {
  for (const b of bassline('b', { style: 'pedal' })) {
    if (b.note && !one_in(P.odds)) synth(P.sub, b.note, { dur: b.len * 0.6, amp: 0.42 * b.vel })
    sleep(b.dur)
  }
})
