// role: perc
// genres: ae 1
// energy: 0.3-1
fx({ delay: 0.2, rev: 0.1 })
loop('hats', (i) => {
  const step = vary('step', [0.25, 1 / 3, 0.2, 0.125], 2)
  for (let k = 0; k < Math.round(4 / step); k++) {
    if (one_in(vary('d', [2, 3], 4))) synth('hat_synth', 60, { amp: rrand(0.1, 0.3), pan: Math.sin(k + i) * 0.7 })
    sleep(step)
  }
})
