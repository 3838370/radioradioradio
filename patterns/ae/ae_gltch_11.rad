// role: perc
// genres: ae 0.95, drill 0.5
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch_fast', gl_crunch2: 'gl_crunch', gl_hiss: 'gl_hiss' })
fx({ crush: 0.32, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 11 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 8, 40, 0.52, 1797, 2], [9, 'gl_crunch', 1, 60, 0.41, 4640, 2], [10, 'gl_buzz', 2, 37, 0.62, 1316, 1],
    [14, 'gl_crunch2', 4, 60, 0.55, 2701, 1], [18, 'gl_crunch2', 4, 60, 0.62, 2290, 1], [22, 'gl_crunch', 1, 60, 0.47, 4528, 1],
    [24, 'gl_hiss', 2, 60, 0.5, 8344, 2], [26, 'gl_buzz', 6, 33, 0.65, 200, 1], [32, 'gl_buzz', 8, 32, 0.61, 200, 1],
    [40, 'gl_hiss', 3, 60, 0.49, 4000, 1], [43, 'gl_crunch2', 2, 60, 0.56, 2050, 2], [46, 'gl_buzz', 4, 26, 0.47, 200, 1],
    [51, 'gl_buzz', 2, 38, 0.54, 1888, 1], [53, 'gl_crunch2', 7, 60, 0.52, 1870, 1], [60, 'gl_buzz', 4, 38, 0.6, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
