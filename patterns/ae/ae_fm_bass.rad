// role: bass
// genres: ae 1
// energy: 0.3-1
fx({ lpf: 2500 })
loop('bass', (i) => {
  const hits = spread(vary('h', [5, 7], 8), 16, vary('r', [0, 3, 9], 4))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) synth(vary('v', ['fm_bass', 'fm_bass'], 8), ROOT + choose([0, 0, 1, 12]), { dur: 0.1, amp: 0.45 })
    sleep(0.25)
  }
})
