// role: perc
// genres: ae 0.95, drill 0.5, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_ping: 'gl_ping' })
fx({ crush: 0.34, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 07 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 8, 26, 0.6, 200, 1], [8, 'gl_buzz', 8, 23, 0.62, 200, 1], [16, 'gl_buzz', 3, 35, 0.6, 200, 1],
    [19, 'gl_buzz', 4, 35, 0.61, 200, 2], [24, 'gl_buzz', 8, 23, 0.61, 200, 2], [32, 'gl_buzz', 8, 25, 0.61, 200, 1],
    [40, 'gl_buzz', 8, 33, 0.63, 200, 1], [48, 'gl_buzz', 4, 24, 0.64, 200, 1], [54, 'gl_ping', 1, 84, 0.36, 0, 2],
    [55, 'gl_buzz', 1, 29, 0.59, 200, 1], [57, 'gl_buzz', 1, 45, 0.46, 1644, 2], [58, 'gl_buzz', 2, 28, 0.64, 200, 1],
    [61, 'gl_buzz', 2, 33, 0.6, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
