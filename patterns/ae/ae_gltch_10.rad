// role: perc
// genres: ae 0.95, drill 0.5, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch_fast', gl_hiss: 'gl_hiss' })
fx({ crush: 0.28, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 10 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 5, 39, 0.65, 2269, 1], [8, 'gl_crunch', 8, 60, 0.5, 3692, 2], [16, 'gl_buzz', 4, 45, 0.63, 1763, 1],
    [20, 'gl_crunch', 8, 60, 0.56, 3849, 1], [29, 'gl_buzz', 1, 45, 0.22, 4000, 2], [30, 'gl_buzz', 6, 24, 0.62, 200, 1],
    [36, 'gl_crunch', 3, 60, 0.52, 3056, 2], [39, 'gl_buzz', 3, 36, 0.6, 200, 1], [44, 'gl_buzz', 8, 24, 0.6, 200, 2],
    [52, 'gl_buzz', 2, 26, 0.53, 200, 2], [55, 'gl_hiss', 1, 60, 0.24, 12000, 2], [56, 'gl_buzz', 3, 35, 0.53, 2040, 2],
    [60, 'gl_buzz', 4, 23, 0.49, 200, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
