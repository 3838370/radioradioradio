// role: perc
// genres: ae 0.95
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_hiss: 'gl_hiss', gl_crunch: 'gl_crunch' })
fx({ crush: 0.35, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 01 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 1, 24, 0.35, 200, 1], [1, 'gl_buzz', 2, 24, 0.49, 200, 2], [3, 'gl_buzz', 2, 29, 0.65, 200, 1],
    [6, 'gl_hiss', 1, 60, 0.44, 4000, 2], [7, 'gl_buzz', 1, 24, 0.53, 200, 1], [9, 'gl_buzz', 4, 34, 0.58, 200, 2],
    [15, 'gl_buzz', 2, 25, 0.53, 200, 2], [19, 'gl_buzz', 2, 40, 0.62, 200, 2], [22, 'gl_buzz', 6, 35, 0.58, 200, 2],
    [28, 'gl_buzz', 2, 28, 0.56, 200, 2], [30, 'gl_buzz', 6, 35, 0.58, 200, 2], [36, 'gl_buzz', 8, 39, 0.6, 200, 3],
    [44, 'gl_buzz', 6, 25, 0.59, 200, 1], [50, 'gl_buzz', 3, 24, 0.63, 200, 2], [54, 'gl_buzz', 3, 38, 0.62, 200, 2],
    [59, 'gl_buzz', 1, 24, 0.58, 200, 1], [61, 'gl_crunch', 1, 60, 0.31, 2735, 2], [62, 'gl_buzz', 2, 25, 0.63, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
