// role: perc
// genres: ae 0.95, drill 0.5
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch', gl_hiss: 'gl_hiss' })
fx({ crush: 0.33, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 14 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 8, 40, 0.64, 200, 1], [9, 'gl_buzz', 1, 40, 0.55, 200, 1], [11, 'gl_crunch', 1, 60, 0.52, 2348, 1],
    [13, 'gl_crunch', 1, 60, 0.39, 2897, 2], [15, 'gl_hiss', 1, 60, 0.43, 6879, 2], [16, 'gl_buzz', 6, 25, 0.61, 200, 1],
    [23, 'gl_buzz', 6, 40, 0.49, 200, 2], [29, 'gl_crunch', 3, 60, 0.44, 2392, 1], [32, 'gl_crunch', 2, 60, 0.61, 2203, 2],
    [34, 'gl_crunch', 1, 60, 0.52, 2329, 2], [37, 'gl_buzz', 5, 40, 0.64, 200, 2], [42, 'gl_buzz', 4, 40, 0.62, 200, 1],
    [46, 'gl_crunch', 3, 60, 0.59, 2507, 2], [50, 'gl_hiss', 1, 60, 0.39, 7138, 2], [52, 'gl_buzz', 3, 30, 0.62, 200, 2],
    [56, 'gl_buzz', 8, 33, 0.63, 200, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
