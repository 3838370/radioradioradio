// role: keys
// genres: ae 1
// energy: 0.25-1
params({ bell: 'dx_marimba' })
fx({ delay: 0.25, rev: 0.2 })
loop('marimba', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['m7', 'sus4'], 8), rhythm: 'push', octave: 2, density: 0.8 })) {
    if (c.notes) synth(P.bell, c.notes, { amp: 0.2 * c.vel, strum: 0.06 })
    sleep(c.dur)
  }
})
