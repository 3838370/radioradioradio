// role: perc
// genres: ae 0.95
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch', gl_hiss: 'gl_hiss' })
fx({ crush: 0.34, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 05 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 1, 31, 0.52, 200, 1], [1, 'gl_buzz', 8, 28, 0.64, 200, 1], [9, 'gl_buzz', 6, 29, 0.56, 200, 1],
    [15, 'gl_buzz', 2, 24, 0.55, 200, 2], [17, 'gl_buzz', 8, 27, 0.65, 200, 1], [25, 'gl_buzz', 8, 39, 0.55, 200, 3],
    [33, 'gl_crunch', 3, 60, 0.56, 2830, 1], [37, 'gl_buzz', 1, 24, 0.55, 200, 2], [39, 'gl_buzz', 2, 28, 0.59, 200, 2],
    [41, 'gl_buzz', 2, 38, 0.52, 200, 1], [43, 'gl_buzz', 3, 33, 0.52, 200, 1], [46, 'gl_crunch', 1, 60, 0.54, 1917, 2],
    [48, 'gl_hiss', 1, 60, 0.44, 4000, 2], [50, 'gl_buzz', 2, 33, 0.58, 200, 2], [54, 'gl_buzz', 3, 26, 0.62, 200, 2],
    [58, 'gl_crunch', 1, 60, 0.56, 2615, 2], [60, 'gl_buzz', 2, 24, 0.53, 200, 2], [62, 'gl_buzz', 2, 30, 0.59, 200, 2],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
