// role: perc
// genres: ae 0.95, acid 0.4
// energy: 0.4-1
params({ gl_buzz: 'gl_buzz', gl_crunch: 'gl_crunch', gl_hiss: 'gl_hiss', gl_crunch2: 'gl_crunch_fast' })
fx({ crush: 0.36, lpf: 15000, rev: 0.08, delay: 0.06, amp: 0.85 })
// Rebuilt in code from loop 06 of Erald's GLTCH glitch pack (no samples): 4 bars of 16ths.
// [step, sound, length in steps, note, amp, filter (0 = the instrument's), hits in the step]
loop('glitch', (i) => {
  const ev = [
    [0, 'gl_buzz', 2, 34, 0.43, 200, 1], [3, 'gl_crunch', 2, 60, 0.58, 2653, 2], [5, 'gl_buzz', 5, 40, 0.56, 200, 1],
    [12, 'gl_hiss', 2, 60, 0.47, 4000, 2], [14, 'gl_buzz', 8, 40, 0.57, 200, 3], [23, 'gl_crunch2', 2, 60, 0.39, 5319, 2],
    [27, 'gl_buzz', 5, 30, 0.5, 200, 2], [32, 'gl_buzz', 8, 28, 0.65, 200, 1], [40, 'gl_buzz', 2, 40, 0.59, 200, 1],
    [42, 'gl_buzz', 2, 40, 0.59, 200, 2], [45, 'gl_hiss', 8, 60, 0.61, 4000, 1], [54, 'gl_crunch', 1, 60, 0.5, 2213, 2],
    [57, 'gl_crunch', 2, 60, 0.43, 2557, 2], [61, 'gl_crunch2', 1, 60, 0.42, 5477, 2], [62, 'gl_buzz', 2, 24, 0.56, 200, 1],
  ]
  for (let k = 0; k < 64; k++) {
    for (const [step, snd, len, note, amp, cut, hits] of ev) {
      if (step != k) continue
      for (let r = 0; r < hits; r++) synth(P[snd], note, { dur: len * 0.25 / hits, amp: amp, cutoff: cut || undefined, nudge: r * 0.25 / hits })
    }
    sleep(0.25)
  }
})
