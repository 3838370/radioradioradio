// role: perc
// genres: space 1
// energy: 0.2-1
params({ rim: 'tok' })
fx({ rev: 0.35, delay: 0.3, lpf: 5000 })
loop('tok', (i) => {
  const hits = spread(vary('h', [3, 5], 8), 16, vary('r', [0, 3, 7], 4))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(P.rim, { n: k % 4, amp: 0.16, rate: walk('rate', 0.7, 1.3, 0.1), pan: -0.4 })
    sleep(0.25)
  }
})
