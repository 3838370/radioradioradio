// role: perc
// genres: space 1
// energy: 0.3-1
fx({ rev: 0.25, delay: 0.15, lpf: 6000 })
loop('tabla', (i) => {
  const hits = spread(vary('h', [7, 9, 11], 8), 16, vary('r', [1, 4], 8))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s('tabla2', { n: vary('n' + (k % 4), [3, 10, 17, 24, 31, 40], 8), amp: 0.13, pan: rrand(-0.4, 0.4) })
    sleep(0.25)
  }
})
