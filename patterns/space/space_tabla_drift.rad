// role: perc
// genres: space 1
// energy: 0.15-1
params({ perc: 'tabla' })
fx({ rev: 0.35, delay: 0.2, lpf: 5000 })
loop('tabla', (i) => {
  const hits = spread(vary('h', [5, 7, 9], 8), 16, vary('r', [0, 3, 5], 8))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(P.perc, { n: vary('n' + (k % 3), [2, 7, 13, 18, 22], 8), amp: 0.16, rate: walk('rate', 0.9, 1.1, 0.05), pan: rrand(-0.5, 0.5) })
    sleep(0.25)
  }
})
