// role: lead
// genres: space 1, saw 0.5
// energy: 0-0.9
params({ pad: 'space_choir' })
fx({ rev: 0.6, delay: 0.3 })
loop('choir', (i) => {
  for (const n of melody('d', { style: 'drift', octave: 2 })) {
    if (n.note) synth(P.pad, n.note, { dur: n.len, amp: 0.2 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
