// role: lead
// genres: space 1
// energy: 0.3-1
params({ lead: 'pulse' })
fx({ delay: 0.4, rev: 0.4 })
loop('seq', (i) => {
  const notes = harm(vary('oct', [1, 2], 16), '9')
  const step = vary('step', [0.25, 0.5], 8)
  for (let k = 0; k < 4 / step; k++) {
    synth(P.lead, notes[k % notes.length], { amp: 0.2, cutoff: walk('cut', 400, 2000, 0.1) })
    sleep(step)
  }
})
