// role: bass
// genres: boc 1, saw 0.5
// energy: 0.3-1
params({ acid_bass: 'sh_bass' })
fx({ lpf: 700, wobble: 0.12 })
loop('bass', (i) => {
  for (const b of bassline('b', { style: 'walk' })) {
    if (b.note) synth(P.acid_bass, b.note, { dur: b.len * 0.8, amp: 0.32 * b.vel, cutoff: 400 })
    sleep(b.dur)
  }
})
