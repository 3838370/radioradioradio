// role: bass
// genres: boc 1
// energy: 0.3-1
params({ fm_bass: 'fm_bass' })
fx({ lpf: 1600 })
loop('walk', (i) => {
  for (const b of bassline('b', { style: vary('style', ['walk', 'dub'], 16) })) {
    if (b.note) synth(P.fm_bass, b.note, { dur: b.len * 0.85, amp: 0.45 * b.vel })
    sleep(b.dur)
  }
})
