// role: lead
// genres: boc 1
// energy: 0.3-1
params({ lead: 'mono' })
fx({ rev: 0.5, delay: 0.35, lpf: 3200 })
loop('flute', (i) => {
  for (const n of phrase('f', { beats: 8, density: 0.15, octave: 2, rest: 0.35 })) {
    if (n.note) synth(P.lead, n.note, { dur: n.dur * 0.85, attack: 0.3, release: 1.5, amp: 0.2 * n.vel })
    sleep(n.dur)
  }
})
