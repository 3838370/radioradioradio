// role: lead
// genres: boc 1, saw 0.6
// energy: 0-0.9
params({ prepared: 'toy_piano' })
fx({ rev: 0.4, delay: 0.3, wobble: 0.2 })
loop('toy', (i) => {
  for (const n of melody('t', { style: 'drift', octave: 3 })) {
    if (n.note) synth(P.prepared, n.note, { vel: 0.4 + 0.4 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
