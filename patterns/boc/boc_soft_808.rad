// role: drums
// genres: boc 1, saw 0.6
// energy: 0.2-1
params({ kick: '808bd', snare: '808sd' })
fx({ lpf: 2500, rev: 0.25, wobble: 0.1 })
loop('kit', (i) => {
  const b = beat('b', { style: 'boc_hiphop', density: 0.45 })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 21, amp: 0.8 * st.v })
    if (st.s) s(P.snare, { n: 5, amp: 0.3 * st.v })
    if (st.h) s('808', { n: 1, amp: 0.07 * st.v, pan: -0.25 })
    sleep(swing(0.25, k, 0.12))
  }
})
