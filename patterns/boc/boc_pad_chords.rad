// role: keys
// genres: boc 1, saw 0.6
// energy: 0-1
params({ boc_pad: 'boc_pad' })
fx({ rev: 0.4, lpf: 1800, wobble: 0.25 })
loop('pad', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['add9', 'wide', 'triad'], 16), rhythm: 'long', octave: 1 })) {
    if (c.notes) synth(P.boc_pad, c.notes, { dur: c.len, amp: 0.22 * c.vel })
    sleep(c.dur)
  }
})
