// role: lead
// genres: boc 1
// energy: 0.2-1
params({ lead: 'mono' })
fx({ rev: 0.4, delay: 0.25 })
loop('flute', (i) => {
  for (const n of motif('m', { beats: 8, density: 0.4, octave: 2 })) {
    if (n.note) synth(P.lead, n.note, { dur: n.dur * 0.9, amp: 0.24 * n.vel })
    sleep(n.dur)
  }
})
