// role: lead
// genres: boc 1
// energy: 0-1
params({ boc_lead: 'boc_lead' })
fx({ rev: 0.4, delay: 0.3, wobble: 0.3 })
loop('lead', (i) => {
  for (const n of melody('d', { style: 'drift', octave: 2 })) {
    if (n.note) synth(P.boc_lead, n.note, { dur: n.len, amp: 0.24 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
