// role: perc
// genres: boc 1, saw 0.5
// energy: 0.2-1
params({ rim: 'rs' })
fx({ delay: 0.3, rev: 0.25, lpf: 3500 })
loop('rim', (i) => {
  const hits = spread(vary('h', [2, 3], 8), 16, vary('r', [3, 7], 8))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(P.rim, { n: 0, amp: 0.1, pan: 0.3 })
    sleep(0.25)
  }
})
