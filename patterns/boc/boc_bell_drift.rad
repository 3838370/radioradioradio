// role: lead
// genres: boc 1, saw 0.5
// energy: 0-1
params({ bell: 'dx_bell' })
fx({ rev: 0.5, delay: 0.35, wobble: 0.2 })
loop('bell', (i) => {
  for (const n of melody('b', { style: 'drift', octave: 3 })) {
    if (n.note) synth(P.bell, n.note, { amp: 0.18 * n.vel, detune: n.detune })
    sleep(n.dur)
  }
})
