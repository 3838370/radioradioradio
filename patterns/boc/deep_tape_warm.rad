// role: texture
// genres: boc 1
// energy: 0-1
params({ boc_lead: 'tape_warble' })
fx({ lpf: 7000, wobble: 0.2 })
loop('tape', (i) => {
  const t = tape('t')
  synth('hiss_bed', 70, { dur: 3.5, attack: 0.5, release: 1, amp: 0.3 * t.level })
  if (t.wow > 0.3) synth(P.boc_lead, degree(0, 2), { dur: 2, amp: 0.08 })
  sleep(4)
})
