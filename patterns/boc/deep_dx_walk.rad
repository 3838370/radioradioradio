// role: bass
// genres: boc 1
// energy: 0.3-1
params({ sub: 'dx_bass' })
fx({ lpf: 1300 })
loop('walk', (i) => {
  for (const b of bassline('b', { style: vary('st', ['walk', 'dub', '808'], 16) })) {
    if (b.note) synth(P.sub, b.note, { dur: b.len * 0.8, amp: 0.38 * b.vel })
    sleep(b.dur)
  }
})
