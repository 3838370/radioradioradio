// role: drums
// genres: dark 1
// energy: 0.3-1
params({ kick: '808bd', snare: 'sn', hat: 'hh27', metal: 'metal' })
fx({ lpf: 6000, rev: 0.35, crush: 0.2 })
loop('beat', (i) => {
  const b = beat('ht', { style: 'halftime', density: 0.3 + 0.4 * ENERGY })
  for (let k = 0; k < 16; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 14, amp: 1.0 * st.v })
    if (st.s) s(P.snare, { n: 31, amp: 0.5 * st.v, rate: 0.8 })
    if (st.h) s(P.hat, { n: 0, amp: 0.08 * st.v, rate: 0.7 })
    if (st.p) s(P.metal, { n: 7, amp: 0.08, rate: 0.5, pan: rrand(-0.7, 0.7) })
    sleep(0.25)
  }
})
