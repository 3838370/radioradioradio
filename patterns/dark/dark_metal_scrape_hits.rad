// role: perc
// genres: dark 1
// energy: 0.2-1
params({ tension: 'metal_scrape' })
fx({ rev: 0.45, delay: 0.25, lpf: 5000 })
loop('scrape', (i) => {
  const wait = vary('w', [1, 2, 3], 8)
  sleep(wait)
  synth(P.tension, degree(choose([0, 1, 4]), 1), { dur: 0.6, amp: 0.3, pan: rrand(-0.6, 0.6) })
  sleep(4 - wait)
})
