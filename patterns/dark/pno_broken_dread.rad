// role: lead
// genres: dark 1, saw 0.7
// energy: 0-0.8
params({ prepared: 'broken_piano', odds: 4 })
fx({ rev: 0.55, delay: 0.35, lpf: 3000, wobble: 0.45 })
loop('dread', (i) => {
  for (const n of phrase('d', { beats: 8, density: vary('d', [0.1, 0.25], 16), octave: 1, rest: 0.45 })) {
    const iv = vary('cl', [0, 1, 6], 8) // alone, a minor second, a tritone
    if (n.note) synth(P.prepared, iv ? [n.note, n.note + iv] : n.note, { vel: n.vel, nudge: n.nudge * 3 })
    sleep(n.dur)
  }
  if (one_in(P.odds)) synth(P.prepared, KEY - 24, { vel: 1.1, dur: 4 }) // a low bass string, struck hard
})
