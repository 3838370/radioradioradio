// role: bass
// genres: dark 1
// energy: 0.3-1
params({ sub: 'sub808', odds: 2 })
loop('sub', (i) => {
  synth(P.sub, ROOT, { dur: 1.5, amp: 0.65 })
  sleep(vary('a', [2.5, 3], 8))
  if (one_in(P.odds)) synth(P.sub, ROOT + vary('b', [1, -2, 0], 8), { dur: 0.5, amp: 0.5 })
  sleep(4 - vary('a', [2.5, 3], 8))
})
