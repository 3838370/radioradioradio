// role: bass
// genres: dark 1
// energy: 0.25-1
params({ dread: 'dread_sub' })
fx({ lpf: 450, crush: 0.06 })
loop('bass', (i) => {
  for (const b of bassline('b', { style: vary('st', ['sub', 'dub'], 16) })) {
    if (b.note) synth(P.dread, b.note, { dur: b.len, amp: 0.48 * b.vel })
    sleep(b.dur)
  }
})
