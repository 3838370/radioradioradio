// role: perc
// genres: dark 1
// energy: 0.2-1
params({ metal: 'clank' })
fx({ rev: 0.5, delay: 0.3 })
loop('clank', (i) => {
  const hits = spread(vary('h', [2, 3], 8), 16, vary('r', [1, 5, 11], 4))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) synth(P.metal, ROOT + 24 + choose([0, 1, 6]), { amp: 0.3, pan: rrand(-0.6, 0.6) })
    sleep(0.25)
  }
})
