// role: perc
// genres: dark 1
// energy: 0.1-1
params({ metal: 'metal' })
fx({ rev: 0.45, lpf: 4000 })
loop('chains', (i) => {
  const hits = spread(vary('h', [2, 3], 8), 8, vary('r', [1, 5], 8))
  for (let k = 0; k < 8; k++) {
    if (hits[k]) s(P.metal, { n: vary('n', [2, 6, 9], 8), amp: 0.12, rate: 0.6, pan: rrand(-0.5, 0.5) })
    sleep(0.5)
  }
})
