// role: bass
// genres: dark 1
// energy: 0.2-1
params({ dread: 'low_brass' })
fx({ lpf: 700, rev: 0.25 })
loop('brass', (i) => {
  for (const b of bassline('b', { style: 'sub' })) {
    if (b.note) synth(P.dread, b.note, { dur: b.len * 0.9, attack: 0.5, amp: 0.3 * b.vel })
    sleep(b.dur)
  }
})
