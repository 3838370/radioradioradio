// role: texture
// genres: dark 1
// energy: 0-1
params({ odds: 3 })
fx({ rev: 0.35 })
loop('rumble', (i) => {
  synth('metro_rumble', ROOT, { dur: 12, attack: 3, release: 4, amp: 0.6 })
  sleep(16)
})
loop('rails', (i) => {
  for (let k = 0; k < 4; k++) {
    synth('rail', 50, { amp: 0.25 })
    sleep(0.25)
    synth('rail', 52, { amp: 0.18 })
    sleep(0.75)
  }
})
loop('brakes', (i) => {
  sleep(14)
  if (one_in(P.odds)) synth('metro_brake', KEY + 48 + choose([0, 1, 2]), { dur: 1.5, amp: 0.4 })
  sleep(2)
})
