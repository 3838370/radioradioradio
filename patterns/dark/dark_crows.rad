// role: texture
// genres: dark 1
// energy: 0-0.8
params({ nature: 'crow', odds: 3 })
fx({ rev: 0.55, lpf: 4000 })
loop('crows', (i) => {
  sleep(6)
  if (one_in(P.odds)) s(P.nature, { n: rrand_i(0, 3), amp: 0.15, rate: choose([0.8, 1]), pan: rrand(-0.8, 0.8) })
  else if (one_in(P.odds)) s('breath', { n: 0, amp: 0.2, rate: 0.6 })
  sleep(2)
})
