// role: drums
// genres: dark 1
// energy: 0.3-1
params({ kick: '808bd', clap: 'realclaps', hat: 'hh', metal: 'metal' })
fx({ lpf: 3500, rev: 0.25, crush: 0.08 })
loop('kit', (i) => {
  const b = beat('b', { style: 'halftime_dread', density: walk('d', 0.4, 0.8, 0.1) })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 18, amp: 0.9 * st.v })
    if (st.s) s(P.clap, { n: 2, amp: 0.4 * st.v })
    if (st.h) s(P.hat, { n: 9, amp: 0.1 * st.v, pan: 0.2 })
    if (st.p) s(P.metal, { n: 3, amp: 0.08 * st.v, pan: -0.3 })
    sleep(0.25)
  }
})
