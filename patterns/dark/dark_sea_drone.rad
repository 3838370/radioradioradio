// role: texture
// genres: dark 1
// energy: 0-0.9
fx({ rev: 0.55, lpf: 2500, wobble: 0.15 })
loop('sea', (i) => {
  for (const e of collage('c', { pool: ['seawolf', 'crow', 'insect'], rate: walk('r', 0.1, 0.35, 0.1) })) {
    if (e.s) s(e.s, { n: e.n, rate: e.rate * 0.6, begin: e.begin, pan: e.pan, amp: e.amp * 0.8, cut: 4 })
    sleep(e.dur)
  }
})
