// role: keys
// genres: dark 1
// energy: 0.3-1
params({ tension: 'tension_string' })
fx({ rev: 0.35, lpf: 2500 })
loop('strings', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['cluster', 'm7'], 16), rhythm: 'long', octave: 1 })) {
    if (c.notes) synth(P.tension, c.notes, { dur: c.len, amp: 0.22 * c.vel })
    sleep(c.dur)
  }
})
