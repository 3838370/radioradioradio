// role: keys
// genres: dark 1, ae 0.7
// energy: 0.4-1
params({ dread: 'low_brass' })
fx({ lpf: 2000, crush: 0.1, delay: 0.15 })
loop('stabs', (i) => {
  for (const c of chords('c', { voicing: 'fifths', rhythm: 'stab', octave: 1, density: 0.6 })) {
    if (c.notes) synth(P.dread, c.notes, { dur: 0.3, attack: 0.05, amp: 0.26 * c.vel })
    sleep(c.dur)
  }
})
