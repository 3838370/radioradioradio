// role: lead
// genres: dark 1
// energy: 0-1
params({ lead_harsh: 'metal_lead' })
fx({ rev: 0.6, delay: 0.35, lpf: 5000 })
loop('bells', (i) => {
  for (const n of phrase('b', { beats: 8, density: 0.2, octave: 2, rest: 0.4 })) {
    if (n.note) synth(P.lead_harsh, n.note, { amp: 0.2 * n.vel, release: 2 })
    sleep(n.dur)
  }
})
