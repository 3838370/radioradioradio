// role: keys
// genres: acid 1, minimal 0.6
// energy: 0.4-1
params({ organ: 'efd_organ' })
fx({ lpf: 4000, rev: 0.15 })
loop('organ', (i) => {
  for (const c of chords('c', { voicing: 'triad', rhythm: 'offbeat', octave: 1, density: walk('d', 0.4, 0.8, 0.1) })) {
    if (c.notes) synth(P.organ, c.notes, { dur: 0.15, amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
