// role: perc
// genres: acid 0.6
// energy: 0.25-1
params({ odds: 3 })
fx({ lpf: 7000, rev: 0.2 })
loop('hats', (i) => {
  for (let k = 0; k < 16; k++) {
    if (k % 2 == 0 || one_in(P.odds)) s('808', { n: 1, amp: (k % 4 == 2 ? 0.1 : 0.05) * walk('a', 0.7, 1.2, 0.1), pan: 0.3 })
    sleep(0.25)
  }
})
