// role: lead
// genres: acid 1
// energy: 0.3-1
params({ lead: 'saw2_square' })
fx({ rev: 0.35, delay: 0.25, lpf: 3000 })
loop('lead', (i) => {
  for (const n of melody('m', { style: 'ostinato', octave: 2 })) {
    if (n.note) synth(P.lead, n.note, { dur: n.len, amp: 0.2 * n.vel })
    sleep(n.dur)
  }
})
