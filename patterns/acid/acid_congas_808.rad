// role: perc
// genres: acid 1, saw 0.5
// energy: 0.35-1
fx({ rev: 0.2, delay: 0.15 })
loop('congas', (i) => {
  const hits = spread(vary('h', [5, 6], 8), 16, vary('r', [1, 4], 8))
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(choose(['808hc', '808mc', '808lc']), { n: 0, amp: 0.15, pan: rrand(-0.4, 0.4) })
    sleep(0.25)
  }
})
