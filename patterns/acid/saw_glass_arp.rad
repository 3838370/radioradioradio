// role: lead
// genres: acid 0.5
// energy: 0.2-1
params({ bell: 'fm_glass' })
fx({ delay: 0.3, rev: 0.3 })
loop('arp', (i) => {
  for (const n of melody('a', { style: 'ostinato', octave: 3, chord: true })) {
    if (n.note) synth(P.bell, n.note, { amp: 0.16 * n.vel, pan: rrand(-0.4, 0.4) })
    sleep(n.dur)
  }
})
