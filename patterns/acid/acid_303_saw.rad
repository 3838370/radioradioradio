// role: bass
// genres: acid 1
// energy: 0.4-1
params({ acid: 'tb303_saw' })
fx({ lpf: 5000, delay: 0.08 })
loop('acid', (i) => {
  for (const b of bassline('b', { style: 'acid' })) {
    if (b.note) synth(P.acid, b.note + 12, { dur: b.len * (b.slide ? 1.1 : 0.7), amp: 0.36 * b.vel, cutoff: b.accent ? 1800 : walk('cut', 250, 1100, 0.12) })
    sleep(b.dur)
  }
})
