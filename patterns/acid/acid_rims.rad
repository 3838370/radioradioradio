// role: perc
// genres: acid 1, minimal 0.5
// energy: 0.3-1
params({ rim: 'rs' })
fx({ delay: 0.2, lpf: 6000 })
loop('rims', (i) => {
  const hits = spread(vary('h', [4, 5, 7], 8), 16, 3)
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(P.rim, { n: 0, amp: 0.13, pan: k % 2 ? 0.35 : -0.35 })
    sleep(0.25)
  }
})
