// role: keys
// genres: acid 1, minimal 0.5
// energy: 0.35-1
params({ pad: 'dx_pad' })
fx({ delay: 0.3, rev: 0.2 })
loop('stabs', (i) => {
  for (const c of chords('c', { voicing: 'm7', rhythm: 'stab', octave: 1, density: 0.6 })) {
    if (c.notes) synth(P.pad, c.notes, { dur: 0.2, attack: 0.005, release: 0.4, amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
