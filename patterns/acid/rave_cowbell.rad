// role: perc
// genres: acid 1
// energy: 0.5-1
fx({ delay: 0.3, rev: 0.15, lpf: 7000 })
loop('bell', (i) => {
  const hits = spread(vary('h', [3, 5], 8), 8, vary('r', [1, 3], 8))
  for (let k = 0; k < 8; k++) {
    if (hits[k]) s('cb', { n: 0, amp: 0.1, rate: vary('rate', [1, 1.2], 16), pan: 0.3 })
    sleep(0.5)
  }
})
