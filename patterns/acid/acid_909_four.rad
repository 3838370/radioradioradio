// role: drums
// genres: acid 1
// energy: 0.45-1
params({ clap: 'realclaps', hat: 'linnhats' })
fx({ lpf: 9000, rev: 0.08 })
loop('kit', (i) => {
  const b = beat('b', { style: 'four', density: 0.6 })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s('909', { n: 0, amp: 0.85 * st.v })
    if (st.s) s(P.clap, { n: 1, amp: 0.3 * st.v })
    if (st.h) s(P.hat, { n: 2, amp: 0.12 * st.v, pan: 0.2 })
    sleep(0.25)
  }
})
