// role: keys
// genres: dub 0.5
// energy: 0.3-1
params({ organ: 'efd_organ' })
fx({ delay: 0.35, rev: 0.2, lpf: 3500 })
loop('stabs', (i) => {
  for (const c of chords('c', { voicing: vary('v', ['m7', 'sus4'], 16), rhythm: 'stab', octave: 1, density: 0.5 })) {
    if (c.notes) synth(P.organ, c.notes, { dur: 0.15, amp: 0.2 * c.vel })
    sleep(c.dur)
  }
})
