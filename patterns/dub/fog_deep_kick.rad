// role: drums
// genres: dub 1
// energy: 0.15-1
params({ kick: 'bd', hat: 'hh', odds: 6 })
fx({ lpf: 1400, rev: 0.35 })
loop('kick', (i) => {
  s(P.kick, { n: 12, amp: 0.9 })
  sleep(1)
})
loop('hats', (i) => {
  sleep(0.5)
  if (!one_in(P.odds)) s(P.hat, { n: vary('hn', [1, 5, 9], 16), amp: walk('ha', 0.05, 0.12, 0.1), pan: 0.3 })
  sleep(0.5)
})
