// role: perc
// genres: dub 1
// energy: 0.2-1
params({ perc: 'perc' })
fx({ lpf: 6000, rev: 0.2, delay: 0.15 })
loop('shake', (i) => {
  const hits = spread(vary('hits', [9, 11, 13], 8), 16)
  for (let k = 0; k < 16; k++) {
    if (hits[k]) s(P.perc, { n: 1, amp: (k % 4 == 2 ? 0.12 : 0.05) * walk('a', 0.6, 1.2, 0.1), pan: rrand(-0.4, 0.4) })
    sleep(0.25)
  }
})
