// role: keys
// genres: dub 1, minimal 0.7
// energy: 0.2-1
params({ stab: 'stab' })
fx({ delay: 0.6, rev: 0.35 })
loop('stab', (i) => {
  fx({ lpf: walk('lpf', 500, 2600, 0.15) })
  const hits = spread(vary('hits', [2, 3, 3, 5], 4), 8, vary('rot', [1, 3, 5], 8))
  for (let k = 0; k < 8; k++) {
    if (hits[k]) synth(P.stab, harm(1, vary('ext', ['7', '9'], 16)), { dur: 0.12, amp: 0.4, cutoff: 1400 })
    sleep(0.5)
  }
})
