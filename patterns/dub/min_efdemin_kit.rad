// role: drums
// genres: dub 0.5
// energy: 0.35-1
params({ kick: 'clubkick', rim: 'rs', hat: 'hh', perc: 'perc' })
fx({ lpf: 8000, rev: 0.08 })
loop('kit', (i) => {
  const b = beat('b', { style: 'efdemin', density: walk('d', 0.4, 0.8, 0.1) })
  for (let k = 0; k < b.length; k++) {
    const st = b[k]
    if (st.k) s(P.kick, { n: 2, amp: 0.8 * st.v })
    if (st.s) s(P.rim, { n: 0, amp: 0.14 * st.v })
    if (st.h) s(P.hat, { n: 2, amp: 0.1 * st.v, pan: 0.25 })
    if (st.p) s(P.perc, { n: 0, amp: 0.07 * st.v, pan: -0.3 })
    sleep(swing(0.25, k, 0.08))
  }
})
