// role: perc
// genres: dub 1
// energy: 0.2-1
params({ rim: 'rs' })
fx({ delay: 0.55, lpf: 4000, rev: 0.2 })
loop('rim', (i) => {
  const hits = spread(vary('n', [1, 2, 3], 4), 8, vary('rot', [1, 3, 5, 6], 4))
  for (let k = 0; k < 8; k++) {
    if (hits[k]) s(P.rim, { n: 0, amp: 0.2, pan: walk('pan', -0.6, 0.6, 0.2) })
    sleep(0.5)
  }
})
