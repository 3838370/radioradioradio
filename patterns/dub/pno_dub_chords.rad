// role: keys
// genres: dub 1
// energy: 0.1-0.9
params({ keys: 'felt' })
fx({ rev: 0.35, delay: 0.55, lpf: 2400 })
loop('chords', (i) => {
  const hits = spread(vary('h', [2, 3], 8), 8, vary('rot', [1, 3, 5], 8))
  for (let k = 0; k < 8; k++) {
    if (hits[k]) synth(P.keys, harm(1, '9'), { vel: 0.7, dur: 0.2, strum: -0.015 })
    sleep(0.5)
  }
})
