// role: texture
// genres: dub 1
// energy: 0.1-1
fx({ delay: 0.55, rev: 0.45, lpf: 3500 })
loop('voices', (i) => {
  for (const e of collage('c', { pool: ['speech', 'east', 'speechless'], rate: walk('r', 0.15, 0.45, 0.1) })) {
    if (e.s) s(e.s, { n: e.n, rate: e.rate, begin: e.begin, pan: e.pan, amp: e.amp * 0.7, cut: 1.5 })
    sleep(e.dur)
  }
})
